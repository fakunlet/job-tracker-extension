{
  "manifest_version": 3,
  "name": "Job Application Tracker",
  "version": "1.0",
  "description": "Save a job application to your local job tracker.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save a job application"
  },
  "host_permissions": [
    "http://localhost:8080/*"
  ]
}
